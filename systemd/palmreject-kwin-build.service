[Unit]
Description=Build and test the PalmReject KWin RPMs as an unprivileged user
PartOf=palmreject-kwin-update.service

[Service]
Type=oneshot
DynamicUser=yes
CacheDirectory=palmreject-kwin-build
CacheDirectoryMode=0700
WorkingDirectory=/var/cache/palmreject-kwin-build
Environment=HOME=/var/cache/palmreject-kwin-build
ExecStartPre=/usr/bin/python3 -I -c 'import os, shutil; shutil.rmtree("work") if os.path.lexists("work") else None'
ExecStart=/usr/bin/python3 -I /usr/local/libexec/palmreject/kwin/build-update.py /run/palmreject-kwin-update/verified/kwin.src.rpm /var/cache/palmreject-kwin-build/work
TimeoutStartSec=4h
Nice=10
PrivateNetwork=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
