+void TestLibinputDevice::testResetTapGestures()
+{
+    libinput_device native;
+    native.tapFingerCount = 3;
+    native.tapToClick = true;
+    native.tapAndDrag = true;
+    native.tapDragLock = true;
+    Device device(&native);
+    QSignalSpy changed(&device, &Device::tapToClickChanged);
+    QVERIFY(device.resetTapGestures());
+    QCOMPARE(native.tapResetCalls, QList<libinput_config_tap_state>({LIBINPUT_CONFIG_TAP_DISABLED, LIBINPUT_CONFIG_TAP_ENABLED}));
+    QVERIFY(native.tapToClick);
+    QVERIFY(device.isTapToClick());
+    QVERIFY(native.tapAndDrag);
+    QVERIFY(native.tapDragLock);
+    QVERIFY(changed.isEmpty());
+    QVERIFY(!device.cancelTapGestures()); // Ordinary/physical devices rejected.
+
+    native.tapResetCalls.clear();
+    native.setTapToClickReturnValue = 1;
+    QVERIFY(!device.resetTapGestures());
+    QCOMPARE(native.tapResetCalls.size(), 1);
+    QVERIFY(device.isTapToClick());
+
+    native.tapToClick = false;
+    native.tapResetCalls.clear();
+    QVERIFY(device.resetTapGestures());
+    QVERIFY(native.tapResetCalls.isEmpty());
+
+    libinput_device proxy;
+    proxy.name = "PalmReject MacBookPro16,1 Touchpad";
+    proxy.sysName = "event42";
+    proxy.udevDevpath = "/devices/virtual/input/input42";
+    proxy.vendor = 0x05ac;
+    proxy.product = 0x0340;
+    proxy.pointer = true;
+    proxy.tapFingerCount = 3;
+    proxy.tapToClick = true;
+    Device virtualDevice(&proxy);
+    QVERIFY(virtualDevice.metaObject()->indexOfSlot("cancelTapGestures()") >= 0);
+    QVERIFY(!virtualDevice.cancelTapGestures()); // Missing connection handler.
+    connect(&virtualDevice, &Device::tapGestureCancellationRequested, &virtualDevice,
+            [&virtualDevice](const QDBusMessage &request) {
+                QDBusConnection::sessionBus().send(request.createReply(QVariantList{virtualDevice.resetTapGestures()}));
+            }, Qt::DirectConnection);
+    QDBusInterface interface{
+        QStringLiteral("org.kde.kwin.tests.libinputdevice"),
+        QStringLiteral("/org/kde/KWin/InputDevice/event42"),
+        QStringLiteral("org.kde.KWin.InputDevice")};
+    QDBusPendingReply<bool> reply = interface.asyncCall(QStringLiteral("cancelTapGestures"));
+    QTRY_VERIFY_WITH_TIMEOUT(reply.isFinished(), 1000);
+    QVERIFY2(!reply.isError(), qPrintable(reply.error().message()));
+    QVERIFY(reply.value());
+    QVERIFY(proxy.tapToClick);
+    QCOMPARE(proxy.tapResetCalls.size(), 2);
+}
