+bool Device::resetTapGestures()
+{
+    const auto saved = libinput_device_config_tap_get_enabled(m_device);
+    if (saved == LIBINPUT_CONFIG_TAP_DISABLED) {
+        return true;
+    }
+    if (libinput_device_config_tap_set_enabled(m_device, LIBINPUT_CONFIG_TAP_DISABLED) != LIBINPUT_CONFIG_STATUS_SUCCESS) {
+        return false;
+    }
+    // libinput releases tap-generated buttons on disable and neutralizes all
+    // existing contacts on re-enable, including sticky drag-lock state.
+    return libinput_device_config_tap_set_enabled(m_device, saved) == LIBINPUT_CONFIG_STATUS_SUCCESS;
+}
+
+bool Device::cancelTapGestures()
+{
+    if (!m_isVirtual || !isTouchpad() || m_vendor != 0x05ac || m_product != 0x0340
+        || m_name != QStringLiteral("PalmReject MacBookPro16,1 Touchpad")) {
+        return false;
+    }
+    if (!calledFromDBus() || !isSignalConnected(QMetaMethod::fromSignal(&Device::tapGestureCancellationRequested))) {
+        return false;
+    }
+    // Acknowledge only after the compositor thread has delivered releases.
+    // Never block the input thread: shutdown waits for that thread to finish.
+    setDelayedReply(true);
+    Q_EMIT tapGestureCancellationRequested(message());
+    return false; // Ignored by Qt for a delayed D-Bus reply.
 }
 
